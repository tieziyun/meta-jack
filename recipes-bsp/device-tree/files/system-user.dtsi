/*
 * Custom PL IP device tree overlay.
 *
 * Fill in after Vivado block design is finalised and base addresses are known.
 * Typical nodes needed:
 *
 *   - AXI DMA (if not handled by DTG — verify Rx/Tx channel mapping)
 *   - Custom packet filter IP (compatible string must match driver)
 *   - AXI-Lite register bank for filter rules
 *
 * Example skeleton (replace 0xADDR with values from Vivado Address Editor):
 *
 * / {
 *     amba_pl: amba_pl {
 *         #address-cells = <1>;
 *         #size-cells = <1>;
 *         ranges;
 *
 *         xdp_filter@40000000 {
 *             compatible = "jack,xdp-pl-filter";
 *             reg = <0x40000000 0x10000>;
 *             interrupt-parent = <&intc>;
 *             interrupts = <0 29 4>;
 *         };
 *
 *         axi_dma@40400000 {
 *             compatible = "xlnx,axi-dma-1.00.a";
 *             reg = <0x40400000 0x10000>;
 *             interrupt-parent = <&intc>;
 *             interrupts = <0 30 4 0 31 4>;
 *             xlnx,include-sg;
 *             xlnx,addrwidth = <32>;
 *             dma-channel@40400000 {
 *                 compatible = "xlnx,axi-dma-mm2s-channel";
 *                 interrupts = <0 30 4>;
 *             };
 *             dma-channel@40400030 {
 *                 compatible = "xlnx,axi-dma-s2mm-channel";
 *                 interrupts = <0 31 4>;
 *             };
 *         };
 *     };
 * };
 */

