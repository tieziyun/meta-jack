// SPDX-License-Identifier: GPL-2.0+
// Self-contained device tree for PYNQ-Z2 (XC7Z020-1CLG400C).
// PS peripherals: UART1 console, GEM0 RGMII Ethernet, SDHCI0, USB0.
// 512 MB DDR3 at 0x00000000, 33.333 MHz PS_CLK.
// No kernel or dt-bindings includes — standalone compile via device-tree.bb.
/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "Digilent PYNQ-Z2";
	compatible = "digilent,zynq-pynq-z2", "xlnx,zynq-7000";

	aliases {
		ethernet0 = &gem0;
		serial0   = &uart0;
		spi0      = &qspi;
		mmc0      = &sdhci0;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x20000000>;
	};

	chosen {
		bootargs = "console=ttyPS0,115200 earlycon loglevel=7 systemd.log_level=debug root=/dev/mmcblk0p2 ro rootwait";
		stdout-path = "serial0:115200n8";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a9";
			device_type = "cpu";
			reg = <0>;
			clocks = <&clkc 3>;
			clock-latency = <1000>;
		};

		cpu1: cpu@1 {
			compatible = "arm,cortex-a9";
			device_type = "cpu";
			reg = <1>;
			clocks = <&clkc 3>;
		};
	};

	fpga_full: fpga-region {
		compatible = "fpga-region";
		fpga-mgr = <&devcfg>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
	};


	regulator_vccpint: fixedregulator {
		compatible = "regulator-fixed";
		regulator-name = "VCCPINT";
		regulator-min-microvolt = <1000000>;
		regulator-max-microvolt = <1000000>;
		regulator-boot-on;
		regulator-always-on;
	};

	usb_phy0: usb_phy@0 {
		#phy-cells = <0>;
		compatible = "ulpi-phy";
		reg = <0xe0002000 0x1000>;
		view-port = <0x0170>;
		reset-gpios = <&gpio0 46 1>;
		drv-vbus;
	};

	amba: axi {
		bootph-all;
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		interrupt-parent = <&intc>;
		ranges;

		intc: interrupt-controller@f8f01000 {
			compatible = "arm,cortex-a9-gic";
			#interrupt-cells = <3>;
			interrupt-controller;
			reg = <0xf8f01000 0x1000>,
			      <0xf8f00100 0x100>;
		};

		L2: cache-controller@f8f02000 {
			compatible = "arm,pl310-cache";
			reg = <0xf8f02000 0x1000>;
			interrupts = <0 2 4>;
			arm,data-latency = <3 2 2>;
			arm,tag-latency = <2 2 2>;
			cache-unified;
			cache-level = <2>;
		};

		pmu@f8891000 {
			compatible = "arm,cortex-a9-pmu";
			interrupts = <0 5 4>, <0 6 4>;
			interrupt-parent = <&intc>;
			reg = <0xf8891000 0x1000>,
			      <0xf8893000 0x1000>;
		};

		global_timer: timer@f8f00200 {
			compatible = "arm,cortex-a9-global-timer";
			reg = <0xf8f00200 0x20>;
			interrupts = <1 11 0x301>;
			interrupt-parent = <&intc>;
			clocks = <&clkc 4>;
		};

		scutimer: timer@f8f00600 {
			bootph-all;
			interrupt-parent = <&intc>;
			interrupts = <1 13 0x301>;
			compatible = "arm,cortex-a9-twd-timer";
			reg = <0xf8f00600 0x20>;
			clocks = <&clkc 4>;
		};

		ttc0: timer@f8001000 {
			interrupt-parent = <&intc>;
			interrupts = <0 10 4>, <0 11 4>, <0 12 4>;
			compatible = "cdns,ttc";
			clocks = <&clkc 6>;
			reg = <0xf8001000 0x1000>;
		};

		ttc1: timer@f8002000 {
			interrupt-parent = <&intc>;
			interrupts = <0 37 4>, <0 38 4>, <0 39 4>;
			compatible = "cdns,ttc";
			clocks = <&clkc 6>;
			reg = <0xf8002000 0x1000>;
		};

		watchdog0: watchdog@f8005000 {
			clocks = <&clkc 45>;
			compatible = "cdns,wdt-r1p2";
			interrupt-parent = <&intc>;
			interrupts = <0 9 1>;
			reg = <0xf8005000 0x1000>;
			timeout-sec = <10>;
		};

		slcr: slcr@f8000000 {
			bootph-all;
			#address-cells = <1>;
			#size-cells = <1>;
			compatible = "xlnx,zynq-slcr", "syscon", "simple-mfd";
			reg = <0xf8000000 0x1000>;
			ranges;

			clkc: clkc@100 {
				bootph-all;
				#clock-cells = <1>;
				compatible = "xlnx,ps7-clkc";
				fclk-enable = <0>;
				ps-clk-frequency = <50000000>;
				clock-output-names =
					"armpll", "ddrpll", "iopll", "cpu_6or4x",
					"cpu_3or2x", "cpu_2x", "cpu_1x", "ddr2x", "ddr3x",
					"dci", "lqspi", "smc", "pcap", "gem0", "gem1",
					"fclk0", "fclk1", "fclk2", "fclk3", "can0", "can1",
					"sdio0", "sdio1", "uart0", "uart1", "spi0", "spi1",
					"dma", "usb0_aper", "usb1_aper", "gem0_aper",
					"gem1_aper", "sdio0_aper", "sdio1_aper",
					"spi0_aper", "spi1_aper", "can0_aper", "can1_aper",
					"i2c0_aper", "i2c1_aper", "uart0_aper", "uart1_aper",
					"gpio_aper", "lqspi_aper", "smc_aper", "swdt",
					"dbg_trc", "dbg_apb";
				reg = <0x100 0x100>;
			};

			rstc: rstc@200 {
				compatible = "xlnx,zynq-reset";
				reg = <0x200 0x48>;
				#reset-cells = <1>;
				syscon = <&slcr>;
			};

			pinctrl0: pinctrl@700 {
				compatible = "xlnx,pinctrl-zynq";
				reg = <0x700 0x200>;
				syscon = <&slcr>;
			};
		};

		mc: memory-controller@f8006000 {
			compatible = "xlnx,zynq-ddrc-a05";
			reg = <0xf8006000 0x1000>;
		};

		devcfg: devcfg@f8007000 {
			compatible = "xlnx,zynq-devcfg-1.0";
			reg = <0xf8007000 0x100>;
			interrupt-parent = <&intc>;
			interrupts = <0 8 4>;
			clocks = <&clkc 12>;
			clock-names = "ref_clk";
			syscon = <&slcr>;
		};

		dmac_s: dma-controller@f8003000 {
			compatible = "arm,pl330", "arm,primecell";
			reg = <0xf8003000 0x1000>;
			interrupt-parent = <&intc>;
			interrupts = <0 13 4>,
			             <0 14 4>, <0 15 4>,
			             <0 16 4>, <0 17 4>,
			             <0 40 4>, <0 41 4>,
			             <0 42 4>, <0 43 4>;
			#dma-cells = <1>;
			clocks = <&clkc 27>;
			clock-names = "apb_pclk";
		};

		gpio0: gpio@e000a000 {
			compatible = "xlnx,zynq-gpio-1.0";
			#gpio-cells = <2>;
			clocks = <&clkc 42>;
			gpio-controller;
			interrupt-controller;
			#interrupt-cells = <2>;
			interrupt-parent = <&intc>;
			interrupts = <0 20 4>;
			reg = <0xe000a000 0x1000>;
			status = "okay";
		};

		qspi: spi@e000d000 {
			bootph-all;
			compatible = "xlnx,zynq-qspi-1.0";
			reg = <0xe000d000 0x1000>;
			interrupt-parent = <&intc>;
			interrupts = <0 19 4>;
			clocks = <&clkc 10>, <&clkc 43>;
			clock-names = "ref_clk", "pclk";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
		};

		gem0: ethernet@e000b000 {
			compatible = "xlnx,zynq-gem", "cdns,gem";
			reg = <0xe000b000 0x1000>;
			interrupts = <0 22 4>;
			clocks = <&clkc 30>, <&clkc 30>, <&clkc 13>;
			clock-names = "pclk", "hclk", "tx_clk";
			#address-cells = <1>;
			#size-cells = <0>;
			phy-mode = "rgmii-id";
			status = "disabled";
		};

		sdhci0: mmc@e0100000 {
			bootph-all;
			compatible = "arasan,sdhci-8.9a";
			status = "okay";
			clock-names = "clk_xin", "clk_ahb";
			clocks = <&clkc 21>, <&clkc 32>;
			interrupt-parent = <&intc>;
			interrupts = <0 24 4>;
			reg = <0xe0100000 0x1000>;
		};

		uart0: serial@e0000000 {
			bootph-all;
			compatible = "xlnx,xuartps", "cdns,uart-r1p8";
			status = "okay";
			clocks = <&clkc 23>, <&clkc 40>;
			clock-names = "uart_clk", "pclk";
			reg = <0xe0000000 0x1000>;
			interrupts = <0 27 4>;
		};

		uart1: serial@e0001000 {
			compatible = "xlnx,xuartps", "cdns,uart-r1p8";
			status = "disabled";
			clocks = <&clkc 24>, <&clkc 41>;
			clock-names = "uart_clk", "pclk";
			reg = <0xe0001000 0x1000>;
			interrupts = <0 50 4>;
		};

		usb0: usb@e0002000 {
			compatible = "xlnx,zynq-usb-2.20a", "chipidea,usb2";
			status = "okay";
			clocks = <&clkc 28>;
			interrupt-parent = <&intc>;
			interrupts = <0 21 4>;
			reg = <0xe0002000 0x1000>;
			phy_type = "ulpi";
			dr_mode = "host";
			usb-phy = <&usb_phy0>;
		};

		i2c0: i2c@e0004000 {
			compatible = "cdns,i2c-r1p10";
			status = "okay";
			clocks = <&clkc 38>;
			interrupt-parent = <&intc>;
			interrupts = <0 25 4>;
			reg = <0xe0004000 0x1000>;
			#address-cells = <1>;
			#size-cells = <0>;
		};


		amba_pl: amba_pl {
			compatible = "simple-bus";
			#address-cells = <1>;
			#size-cells = <1>;
			interrupt-parent = <&intc>;
			ranges;
			/* PL masters (frmbuf) address DDR 0x0-0x20000000 (512 MB) 1:1 */
			dma-ranges = <0x0 0x0 0x20000000>;

			/* 1-bit AXI GPIO output, sole purpose: drive the frmbuf's
			 * ap_rst_n. The frmbuf is an HLS core whose only reset is the
			 * hardware pin, and the driver must toggle it via this GPIO. */
			axi_gpio0: gpio@41200000 {
				compatible = "xlnx,xps-gpio-1.00.a";
				reg = <0x41200000 0x10000>;
				#gpio-cells = <2>;
				gpio-controller;
				xlnx,all-outputs = <1>;
				xlnx,gpio-width = <1>;
				clocks = <&clkc 15>;
			};

			/* Video Frame Buffer Read — replaces the VDMA + subset-converter
			 * gasket. Single ap_clk on FCLK1 (clkc 16, 200 MHz); control at
			 * 0x43c20000; frame-done IRQ on xlconcat In1 (SPI 62). BGRX8
			 * memory format == DRM XR24. Reset via axi_gpio0 (active-low). */
			v_frmbuf_rd_0: v_frmbuf_rd@43c20000 {
				compatible = "xlnx,v-frmbuf-rd-v3.0";
				reg = <0x43c20000 0x10000>;
				interrupt-parent = <&intc>;
				interrupts = <0 30 4>;
				clocks = <&clkc 16>;
				clock-names = "ap_clk";
				reset-gpios = <&axi_gpio0 0 1>;  /* 1 = GPIO_ACTIVE_LOW */
				xlnx,dma-addr-width = <32>;
				xlnx,vid-formats = "xrgb8888";
				xlnx,pixels-per-clock = <1>;
				/* Required by xilinx_frmbuf driver (probe -EINVAL if absent);
				 * must match the IP's Max Columns/Rows config (3840x2160). */
				xlnx,max-width = <3840>;
				xlnx,max-height = <2160>;
				#dma-cells = <1>;
			};

			axi_dynclk_0: axi-dynclk@43c10000 {
				compatible = "dglnt,axi-dynclk";
				reg = <0x43c10000 0x1000>;
				clocks = <&clkc 15>;
				#clock-cells = <0>;
			};

			v_tc_0: v-timing-controller@43c00000 {
				compatible = "xlnx,bridge-v-tc-6.1";
				reg = <0x43c00000 0x1000>;
				interrupts = <0 31 4>;
				interrupt-parent = <&intc>;
				xlnx,pixels-per-clock = <1>;
				/* 6.18 xlnx_vtc requires both clocks (optional on 5.15).
				 * Video clock is the dynclk output — the pixel clock. */
				clocks = <&clkc 15>, <&axi_dynclk_0>;
				clock-names = "s_axi_aclk", "clk";
			};

			/* Encoder for the PL rgb2dvi IP — no AXI interface, so no reg.
			 * Bound as a component of the xlnx DRM master, discovered via
			 * the of_graph endpoint link from xlnx_pl_disp. */
			digilent_hdmi_0: digilent_hdmi {
				compatible = "digilent,hdmi";
				clocks = <&axi_dynclk_0>;
				clock-names = "clk";
				digilent,edid-i2c = <&i2c0>;
				digilent,fmax = <150000>;

				port {
					hdmi_ep: endpoint {
						remote-endpoint = <&pl_disp_ep>;
					};
				};
			};

			xlnx_pl_disp_0: xlnx_pl_disp {
				compatible = "xlnx,pl-disp";
				dmas = <&v_frmbuf_rd_0 0>;
				dma-names = "dma0";
				xlnx,vformat = "XR24";
				xlnx,bridge = <&v_tc_0>;

				port {
					pl_disp_ep: endpoint {
						remote-endpoint = <&hdmi_ep>;
					};
				};
			};
		};
	};
};
